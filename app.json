{
  "expo": {
    "name": "Bandhanaa",
    "slug": "dating-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icons/app-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.datingmatch.datingapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/app-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.datingmatch.datingapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "yourapp"
          }
        }
      ]
    },
    "web": {
      "favicon": "./assets/icons/app-icon.png" 
    },
    "plugins": [
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "color": "#FF6B6B"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ec824628-8fdf-401e-8f10-a4c3912ec013"
      }
    },
    "owner": "skvijay"
  }
}